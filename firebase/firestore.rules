rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myKitchen() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kitchenId;
    }

    // Links a login to its kitchen. Created once, in the same batch as the kitchen.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/kitchens/$(request.resource.data.kitchenId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      // Account deletion (store requirement): the owner removes their own link last.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /kitchens/{kid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && myKitchen() == kid;
      allow update: if signedIn() && myKitchen() == kid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && myKitchen() == kid;

      // Hygiene records can be added but never edited (tamper-proof history).
      // Only the owner can delete them, when deleting the whole account.
      match /logs/{logId} {
        allow read, create: if signedIn() && myKitchen() == kid;
        allow update: if false;
        allow delete: if signedIn() && myKitchen() == kid;
      }
    }

    // Platform order number -> seal code. Lets customers find their order by number.
    // Created once with the order; never changed, never listable.
    match /orderRefs/{key} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.kitchenId == myKitchen();
      allow update: if false;
      allow delete: if signedIn() && resource.data.kitchenId == myKitchen(); // account deletion only
    }

    // Public kitchen page (kitchen.html?k=ID): profile and 30-day rating, readable by anyone.
    // The kitchen writes it, but can never set "verifiedVisit" — only KitchenLens staff can
    // (from the Firebase console, or an account with the custom claim admin=true).
    match /publicKitchens/{kid} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && myKitchen() == kid && !('verifiedVisit' in request.resource.data);
      allow update: if (signedIn() && myKitchen() == kid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedVisit']))
        || (signedIn() && request.auth.token.admin == true);
      allow delete: if signedIn() && myKitchen() == kid;
    }

    // Customer feedback from the scan page: one answer per seal (document id = seal code),
    // only for a real order, only two yes/no answers. Kitchens read their own; nobody can edit.
    match /feedback/{code} {
      allow create: if exists(/databases/$(database)/documents/orders/$(code))
        && request.resource.data.keys().hasOnly(['kitchenId', 'sealIntact', 'foodHot', 'at'])
        && request.resource.data.kitchenId == get(/databases/$(database)/documents/orders/$(code)).data.kitchenId
        && request.resource.data.sealIntact is bool
        && request.resource.data.foodHot is bool
        && request.resource.data.at is int;
      allow get: if false;
      allow list: if signedIn() && resource.data.kitchenId == myKitchen();
      allow update: if false;
      allow delete: if signedIn() && resource.data.kitchenId == myKitchen(); // account deletion only
    }

    // Public order records: anyone with the exact code can open one (the QR scan),
    // but nobody can list or browse all orders.
    match /orders/{code} {
      allow get: if true;
      allow list: if signedIn() && resource.data.kitchenId == myKitchen();
      allow create: if signedIn() && request.resource.data.kitchenId == myKitchen();
      allow update: if false;
      allow delete: if signedIn() && resource.data.kitchenId == myKitchen(); // account deletion only
    }
  }
}
